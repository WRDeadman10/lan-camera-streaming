# Server network configuration
PORT=3000
HOST=0.0.0.0

# Security & Access Control
# Default access secret PIN required for room creation, join, and signaling
ACCESS_PIN=123456

# CORS & Trust Proxy settings
# Optional comma-separated origins, or * for LAN dev
CORS_ORIGIN=*
TRUST_PROXY=false

# STUN / TURN Configuration (optional fallback)
# Comma-separated STUN server URLs (default: public google stun)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVERS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Logging level: info, debug, warn, error
LOG_LEVEL=info
