{
  "name": "lan-camera-streaming",
  "version": "1.0.11",
  "description": "Production-ready self-hosted LAN camera streaming web application via WebRTC and Socket.IO",
  "main": "src/server/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/server/index.js",
    "cli": "node src/server/cli.js",
    "dev": "node --watch src/server/index.js",
    "postinstall": "node scripts/build-embedded-assets.js",
    "test": "node --test tests/**/*.test.js",
    "bump:version": "node scripts/bump-version.js",
    "build:assets": "node scripts/build-embedded-assets.js",
    "build:exe": "node scripts/build-exe.js"
  },
  "keywords": [
    "webrtc",
    "socket.io",
    "camera-streaming",
    "lan",
    "video-streaming"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "resedit": "^3.1.0",
    "socket.io-client": "^4.8.4"
  }
}
